{
  "manifest_version": 3,
  "name": "BridgAI Browser Automation",
  "version": "0.6.5",
  "minimum_chrome_version": "120",
  "description": "Automazione opzionale del flusso tra BridgAI, ChatGPT, Claude e Gemini.",
  "permissions": [
    "storage",
    "tabs",
    "downloads",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://chatgpt.com/*",
    "https://*.oaiusercontent.com/*",
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "https://*.anthropic.com/*",
    "https://gemini.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "providers.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "BridgAI",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "optional_host_permissions": [
    "https://*/*"
  ]
}
